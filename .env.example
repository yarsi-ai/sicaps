# =============================================================================
# SICAPS Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Required Variables ---

# PostgreSQL connection string (Supabase or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sicaps"

# LLM provider base URL (Ollama OpenAI-compatible endpoint)
LLM_BASE_URL="http://localhost:11434/v1"

# LLM provider API key (required, min 1 character)
LLM_API_KEY="your-api-key-here"

# Public application URL (used for CORS, redirects, metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Console PIN — shared secret for /console route access protection.
# Must be at least 6 characters. Used to gate access to developer tools.
CONSOLE_PIN=

# UI theme name — maps to src/themes/<name>.css (default: earthy)
# Available themes: earthy, purple
# NEXT_PUBLIC_THEME="earthy"

# --- Optional Variables (defaults shown) ---

# LLM model identifier (default: qwen2.5:7b)
# LLM_MODEL="qwen2.5:7b"

# Output token budget for chat replies (default: 500, max: 4096).
# On thinking models (e.g. gemini-2.5-flash) this budget is shared with thinking
# tokens, which alone can spend 300-850 tokens — set 2048 there or replies get
# cut off mid-word. Set it explicitly in production rather than relying on the default.
# LLM_MAX_TOKENS_CHAT=2048

# Thinking budget hint for reasoning models: minimal | low | medium | high.
# Leave unset for non-reasoning providers (Groq llama, Ollama) — they reject it.
# LLM_REASONING_EFFORT="low"

# Node environment (default: development)
# NODE_ENV="development"

# Screening chat version switch: v1 (scripted) or v2 (LLM conversational). Default: v1
# SCREENING_CHAT_VERSION="v1"

# TEMPORARY testing switch. Moves the mandatory image gate to the start of the
# session instead of SCREENING_COMPLETE, so the visual detection flow can be
# exercised without completing the collecting phase. Default: false.
# Retire this together with the branches in ChatScreen.tsx and useChat.ts.
# VISUAL_DETECTION_GATE_AT_START="false"

# Set to "false" to skip typing animation delays (useful for automated testing).
# Default: true (animation enabled).
# TYPING_ANIMATION="true"

# Direct/session-pooled database connection for Prisma migrations (prisma migrate deploy).
# Required only when running migrations against Supabase — use the Session Pooler connection
# string (not the direct connection), since Vercel's build environment lacks IPv6 support
# needed for Supabase's direct connection port.
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Playground Provider Keys (optional) ---
# Only needed if you want to use LLM Playground (/console/playground).
# Each provider is available only when its key is configured.

# Groq (free tier, generous limits)
# PLAYGROUND_GROQ_KEY="gsk_xxxxxxxxxxxxx"

# HuggingFace (free tier, limited)
# PLAYGROUND_HF_KEY="hf_xxxxxxxxxxxxx"

# Gemini (free tier, 250 req/day)
# PLAYGROUND_GEMINI_KEY="AIza_xxxxxxxxxxxxx"

# Ollama (local, no key needed — just the base URL)
# PLAYGROUND_OLLAMA_URL="http://localhost:11434/v1"

# --- Vision API (required when SCREENING_CHAT_VERSION=v2) ---
# External visual prediction API for image-based scabies detection.
# Both URL and API key are required when using v2 mode.

# Vision API base URL (e.g., your ML model endpoint)
# VISION_MODEL_URL="https://your-vision-api.example.com/v1/predict"

# Vision API authentication key
# VISION_MODEL_API_KEY="your-vision-api-key"

# Vision API request timeout in milliseconds (default: 12000)
# VISION_TIMEOUT_MS=12000

# --- Supabase Storage (required when SCREENING_CHAT_VERSION=v2) ---
# Used for storing screening images. Service role key is required for server-side uploads.

# Your Supabase project URL (e.g., https://your-project.supabase.co)
# SUPABASE_URL="https://your-project.supabase.co"

# Supabase service role key (found in Project Settings > API > service_role key)
# CAUTION: This key bypasses RLS. Never expose in client-side code.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"